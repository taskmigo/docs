{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskmigo.github.io/docs/schemas/v0/site.schema.json",
  "title": "Taskmigo v0/site manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "spec"],
  "properties": {
    "kind": {
      "const": "v0/site",
      "description": "The complete versioned manifest kind."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "The resource name."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "An optional immutable Semantic Version tag for this revision."
    },
    "imports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^v0/application/[a-zA-Z0-9_-]+(?:@(?:[~^])?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?$",
        "description": "A v0/application resource reference, optionally followed by a version constraint."
      },
      "description": "Unique v0/application references available to the Site."
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "applications"],
      "properties": {
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "logo", "favicon"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "The displayed Site label."
            },
            "logo": {
              "type": "string",
              "minLength": 1,
              "description": "The Site logo path."
            },
            "favicon": {
              "type": "string",
              "minLength": 1,
              "description": "The Site favicon path."
            }
          }
        },
        "applications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "description": "Application names to expose, in display order."
        }
      }
    }
  }
}
